{
  "name": "barnaby-vscode",
  "displayName": "Barnaby",
  "description": "Lets the Barnaby desktop pet walk you through your code: opens files, scrolls and highlights as it talks.",
  "version": "0.1.2",
  "icon": "icon.png",
  "publisher": "barnaby",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "barnaby.ask", "title": "Barnaby: Ask about this" },
      { "command": "barnaby.next", "title": "Barnaby: Next step" },
      { "command": "barnaby.previous", "title": "Barnaby: Previous step" },
      { "command": "barnaby.stop", "title": "Barnaby: Stop tour" },
      { "command": "barnaby.showLog", "title": "Barnaby: Show log" }
    ],
    "keybindings": [
      { "command": "barnaby.next", "key": "alt+]" },
      { "command": "barnaby.previous", "key": "alt+[" },
      { "command": "barnaby.stop", "key": "alt+escape" }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.0",
    "ws": "^8.18.0"
  }
}
